{
  inputs,
  pkgs,
  ...
}: let
  zen = inputs.zen-browser.packages.${pkgs.stdenv.hostPlatform.system}.beta;

  settings = {
    # Never ask for password
    "signon.rememberSignons" = false;

    # Use host DNS resolver
    "network.trr.mode" = 5;

    # Disable alt key to show menu
    "ui.key.menuAccessKey" = 17;
    "ui.key.menuAccessKeyFocuses" = false;

    "dom.security.https_only_mode" = true;
    "dom.private-attribution.submission.enabled" = false;
    "extensions.pocket.enabled" = false;
    "widget.use-xdg-desktop-portal.file-picker" = 1;
    "middlemouse.paste" = false;

    "full-screen-api.warning.delay" = 0;
    "full-screen-api.warning.timeout" = 0;

    "zen.theme.content-element-separation" = 0;
    "zen.boosts.enabled" = false;

    "browser.ai.control.default" = false;
    "browser.ai.control.linkPreviewKeyPoints" = false;
    "browser.ai.control.pdfjsAltText" = false;
    "browser.ai.control.sidebarChatbot" = false;
    "browser.ai.control.smartTabGroups" = false;
    "browser.ai.control.translations" = false;
  };

  userJs = pkgs.writeText "zen-user.js" ''
    # Generated by NixOS.
    ${pkgs.lib.concatStringsSep "\n" (
      pkgs.lib.mapAttrsToList (
        name: value: "user_pref(${builtins.toJSON name}, ${builtins.toJSON value});"
      )
      settings
    )}
  '';

  profilesIni = pkgs.writeText "zen-profiles.ini" ''
    [General]
    StartWithLastProfile=1
    Version=2

    [Profile0]
    Default=1
    IsRelative=1
    Name=hao
    Path=hao
  '';
in {
  environment.systemPackages = [zen];

  systemd.tmpfiles.rules = [
    "L+ /home/hao/.config/zen/profiles.ini - - - - ${profilesIni}"
    "L+ /home/hao/.config/zen/hao/user.js - - - - ${userJs}"
  ];
}
