binds {
  Mod+Return hotkey-overlay-title="Terminal" repeat=false {
    spawn "ghostty-smart"
  }
  Mod+B hotkey-overlay-title="Zen Browser" repeat=false {
    spawn "zen-beta"
  }
  Mod+N hotkey-overlay-title="Zen Browser Blank Window" repeat=false {
    spawn "zen-beta" "--blank-window"
  }
  Mod+P hotkey-overlay-title="Zen Browser Private Window" repeat=false {
    spawn "zen-beta" "--private-window"
  }
}
