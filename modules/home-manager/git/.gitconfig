[user]
email = haoyiphoh@protonmail.com
name = haoyiphoh

[init]
defaultBranch = main

[core]
pager = delta

[interactive]
diffFilter = delta --color-only

[delta]
# use n and N to move between diff sections
navigate = true
# set to true if you're in a terminal w/ a light background color (e.g. the default macOS terminal)
light = false
side-by-side = false

[merge]
conflictstyle = diff3

[diff]
colorMoved = default
